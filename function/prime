l=[]
for i in range(10):
    a=int(input("Enter the number"))
    l.append(a)
    
def isprime(n):
    c=0
    for i in range(1,n+1):
        if n%i==0:
            c=c+1
    if c==2:
        return True

max=0
for val in l:
    if isprime(val)==True:
        if val>max:
            max=val
print("The max prime no is ",max)
