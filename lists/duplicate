l1=[]
z=int(input("Enter no of inputs"))
for i in range(z):
    a=int(input("Enter the number"))
    l1.append(a)
print("The list is:",l1)
l2=[]
c=len(l1)
for i in range(c):
    x=l1[i]
    for j in range(i+1,c):
        y=l1[j]
        if x==y:
            l2.append(y)
print("The duplicated items are:",l2)