l1=[]
z=int(input("Enter no of inputs"))
for i in range(z):
    a=int(input("Enter the number"))
    l1.append(a)
print("The list is:",l1)
l2=[]
l3=[]
c=len(l1)
for i in range(c):
    if l1[i]%2==0:
        y=l1[i]
        l2.append(y)
    else:
        x=l1[i]
        l3.append(x)
print("The even numbers are:",l2)
print("The odd numbers are:",l3)