import os
import subprocess

def display_menu():
    print("\nTo-Do List Menu:")
    print("1. View tasks")
    print("2. Add task")
    print("3. Remove task")
    print("4. Exit and open in Notepad")

def view_tasks(tasks):
    if not tasks:
        print("No tasks in your to-do list.")
    else:
        print("Your tasks:")
        for idx, (task, time) in enumerate(tasks, 1):
            print(f"{idx}. {task} (Time: {time})")

def add_task(tasks):
    task = input("Enter the task: ")
    time = input("Enter the time for this task (e.g., 14:00 or 2:00 PM): ")
    tasks.append((task, time))
    print("Task added.")

def remove_task(tasks):
    view_tasks(tasks)
    if tasks:
        try:
            idx = int(input("Enter the task number to remove: "))
            if 1 <= idx <= len(tasks):
                removed = tasks.pop(idx - 1)
                print(f"Removed: {removed[0]} (Time: {removed[1]})")
            else:
                print("Invalid task number.")
        except ValueError:
            print("Please enter a valid number.")

def export_to_notepad(tasks, filename="todo_list.txt"):
    with open(filename, "w") as f:
        if not tasks:
            f.write("No tasks in your to-do list.\n")
        else:
            f.write("Your tasks:\n")
            for idx, (task, time) in enumerate(tasks, 1):
                f.write(f"{idx}. {task} (Time: {time})\n")
    # Open the file in Notepad
    subprocess.Popen(['notepad.exe', filename])

def main():
    tasks = []
    while True:
        display_menu()
        choice = input("Choose an option: ")
        if choice == '1':
            view_tasks(tasks)
        elif choice == '2':
            add_task(tasks)
        elif choice == '3':
            remove_task(tasks)
        elif choice == '4':
            export_to_notepad(tasks)
            print("Goodbye!")
            break
        else:
            print("Invalid choice. Try again.")

if __name__ == "__main__":
    main()